# ============================================================
# ikrarku Sites — PRODUCTION (https://ikrarku.id)
# Salin ke .env.production di VPS. JANGAN di-commit.
# Semua nilai ISI_... wajib diganti. Tanpa spasi; bila ada spasi, apit dengan "...".
# ============================================================
NODE_ENV=production
API_PORT=5180
CLIENT_ORIGIN=https://ikrarku.id
PUBLIC_BASE_URL=https://ikrarku.id

# Hanya dipakai bila database masih kosong. Database production yang
# disalin dari staging sudah punya akun admin, jadi nilai ini tidak menimpa
# password admin yang ada — tetap wajib diisi kuat (preflight menolak nilai lemah).
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=ISI_EMAIL_ADMIN
ADMIN_BOOTSTRAP_PASSWORD=ISI_PASSWORD_ACAK_MIN_12

DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
RECEIPT_DIR=/app/receipts
DB_FILE=/app/data/ikrarku.sqlite

# Production WAJIB mayar (simulation ditolak di production).
PAYMENT_MODE=mayar
MAYAR_API_KEY=ISI_JWT_UTUH_DARI_MAYAR
MAYAR_API_BASE=https://api.mayar.id/hl/v1
# Token BARU, berbeda dari staging. Daftarkan di dashboard Mayar:
#   https://ikrarku.id/api/webhooks/mayar?token=NILAI_DI_BAWAH
MAYAR_WEBHOOK_TOKEN=ISI_HASIL_openssl_rand_hex_24
MAYAR_INVOICE_EXPIRY_HOURS=24
# Cek status invoice ke Mayar untuk order pending (ms). Jaring pengaman webhook.
MAYAR_RECONCILE_MS=120000

# Sama dengan staging (Google Workspace afarcoteknologi.com).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=developer@afarcoteknologi.com
SMTP_PASS=ISI_APP_PASSWORD_16_HURUF
SMTP_FROM="ikrarku <developer@afarcoteknologi.com>"

SESSION_IDLE_MINUTES=120
EDITOR_ACTIVE_ORDER_LIMIT=5
