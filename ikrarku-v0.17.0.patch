+          ))}
+        </div>
+        <div className="settings-card">
+          {tab === "general" && (
+            <>
+              <h3>Workspace preferences</h3>
+              <p>
+                Gunakan menu ini untuk mengelola preferensi umum. Perubahan
+                konten website tetap disimpan melalui Canvas Editor.
+              </p>
