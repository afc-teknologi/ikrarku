+      </label>
+      <div className="danger-zone">
+        <strong>Canvas structure</strong>
+        <p>
+          Canvas ini memiliki {section.columns.length} Column dan{" "}
+          {section.columns.reduce(
+            (total, column) => total + column.features.length,
+            0,
+          )}{" "}
+          Feature.
+        </p>
+      </div>
+    </div>
+  );
 }
 
