+            <input
+              value={text}
+              onChange={(event) => setText(event.target.value)}
+              placeholder="Tulis pesan..."
+            />
+            <button type="submit">
+              <Send size={16} />
+            </button>
+          </form>
+        </div>
+      )}
+      <button className="chat-launcher" onClick={() => onOpenChange(!open)}>
+        {open ? (
+          <X size={22} />
+        ) : (
+          <>
+            <MessageCircle size={22} />
+            <span>Live Chat</span>
+          </>
