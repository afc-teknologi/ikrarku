+                    Web Designer
+                    <strong>
+                      {selected.order.editor_name || "Unassigned"}
+                    </strong>
+                  </label>
+                  <label>
+                    Assigned CS
+                    <strong>{selected.order.cs_name || "Unassigned"}</strong>
