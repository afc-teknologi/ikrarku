NODE_ENV=development
API_PORT=5180
CLIENT_ORIGIN=http://localhost:5173

# Optional custom storage paths
DATA_DIR=server/data
UPLOAD_DIR=server/uploads
RECEIPT_DIR=server/receipts
DB_FILE=server/data/ikrarku.sqlite

# Optional SMTP. Without SMTP, verification and receipt emails remain in email_outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ikrarku Sites <noreply@yourdomain.com>

ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@ikrarku.local
ADMIN_BOOTSTRAP_PASSWORD=
