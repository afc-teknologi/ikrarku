# Runtime
NODE_ENV=production
API_PORT=5180
CLIENT_ORIGIN=https://staging.ikrarku.id
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
RECEIPT_DIR=/app/receipts
DB_FILE=/app/data/ikrarku.sqlite

# SMTP. Verification and receipt emails stay in email_outbox when SMTP is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ikrarku Sites <noreply@staging.ikrarku.id>
