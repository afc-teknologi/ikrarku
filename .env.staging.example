# ============================================================
# ikrarku Sites v0.14 — STAGING ENVIRONMENT
# Copy to .env.staging. Never commit the real file.
# ============================================================
NODE_ENV=production
API_PORT=5180
CLIENT_ORIGIN=https://staging.ikrarku.id

# Initial Administrator bootstrap. REQUIRED because staging runs NODE_ENV=production.
# Replace with a long random password before first deploy.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@staging.ikrarku.id
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Persistent runtime paths inside Docker
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
RECEIPT_DIR=/app/receipts
DB_FILE=/app/data/ikrarku.sqlite

# STAGING ONLY.
# Do not use simulation for Production Go-Live.
PAYMENT_MODE=simulation
# Set PAYMENT_MODE=mayar to use the mayar.id gateway (customer redirected to Mayar,
# order confirmed via POST /api/webhooks/mayar). Keep 'simulation' for instant local/staging QA.
MAYAR_API_KEY=
MAYAR_API_BASE=https://api.mayar.id/hl/v1
MAYAR_WEBHOOK_TOKEN=

# SMTP is required to close staging acceptance for verification/receipts.
# When empty, messages remain traceable in email_outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ikrarku Staging <noreply@staging.ikrarku.id>"

# ============================================================
# QA REMEDIATION BATCH (TC-073 / TC-101)
# ============================================================
# TC-073 — email verifikasi "Registrasi Aktived" tidak masuk inbox karena SMTP di atas
# masih kosong. Isi SMTP_HOST/PORT/USER/PASS/FROM agar email benar-benar terkirim.
# Selama SMTP kosong, server tetap mengembalikan tautan verifikasi & reset pada response
# API dan menampilkannya di UI, serta menyimpan seluruh pesan pada tabel email_outbox.
# Administrator dapat melihat status pengiriman via GET /api/mailer-status dan
# mengirim ulang lewat POST /api/email-outbox/:id/retry.

# TC-101 — idle session timeout (menit). 0 menonaktifkan idle timeout.
# Nilai ini dipakai server untuk mencabut sesi yang tidak aktif.
SESSION_IDLE_MINUTES=120
