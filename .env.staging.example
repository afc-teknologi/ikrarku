# ============================================================
# ikrarku Sites v0.14 — STAGING ENVIRONMENT
# Copy to .env.staging. Never commit the real file.
# ============================================================
NODE_ENV=production
API_PORT=5180
CLIENT_ORIGIN=https://staging.ikrarku.id

# Initial Administrator bootstrap. REQUIRED because staging runs NODE_ENV=production.
# Replace with a long random password before first deploy.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@staging.ikrarku.id
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Persistent runtime paths inside Docker
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
RECEIPT_DIR=/app/receipts
DB_FILE=/app/data/ikrarku.sqlite

# STAGING ONLY.
# Do not use simulation for Production Go-Live.
PAYMENT_MODE=simulation

# SMTP is required to close staging acceptance for verification/receipts.
# When empty, messages remain traceable in email_outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ikrarku Staging <noreply@staging.ikrarku.id>"
